/node_modules
# /public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
# Compiled bootstrap caches (package-discovery manifest, service list) --
# environment-specific build artifacts regenerated by `artisan
# package:discover`/`config:cache` from whatever is actually in vendor/.
# Committing these bakes dev-only providers (e.g. laravel/pail) into a
# file production blindly loads, even when vendor/ never installed them --
# see the "PailServiceProvider not found" production incident.
/bootstrap/cache/*.php
.env
.env.backup
.env.production
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.vscode
/.nova
/storage/app/backups/*.sql
/storage/framework/cache/*
!/storage/framework/cache/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
database/database.sqlite
