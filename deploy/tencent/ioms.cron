# IOMS -- scheduler (approvals:escalate, reports:dispatch-scheduled,
# subscriptions:lifecycle; see routes/console.php) and the nightly backup.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
* * * * * ioms cd /srv/ioms/app && php artisan schedule:run >> /dev/null 2>&1
30 1 * * * root /usr/local/bin/ioms-backup >> /var/log/ioms-backup.log 2>&1
