<?xml version="1.0" encoding="UTF-8"?>
<!--
    v2.37.0 (Master Audit, P1). This file did not exist. That is the
    concrete reason IOMS had effectively no automated tests: with no
    PHPUnit configuration there was no test database to provision, and
    the schema itself could not be created on anything but MySQL (six
    migrations used MySQL-only raw SQL; see their own v2.37.0 doc
    comments). Both blockers are now fixed, so the suite runs against an
    in-memory SQLite database with no external services required.

    Production is unaffected: this only configures the `testing`
    environment. DB_CONNECTION here overrides .env for tests only.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>

        <!--
            v2.95.0: THE SUITE RUNS WITH NO PAYMENT PROVIDER, ALWAYS.

            These are pinned empty on purpose. A developer who puts real
            sandbox credentials in .env to exercise checkout by hand would
            otherwise have them leak into every test run: Laravel's Dotenv
            does not overwrite variables already set, but it DOES supply ones
            phpunit never mentioned. The suite then ran with a live gateway
            bound, and getPaymentMethods() made REAL HTTP CALLS to the
            provider from tests that never meant to touch the network:
            slow, flaky, and dependent on whose machine it ran on.

            A test that needs a gateway binds one explicitly with config()
            and fakes the HTTP boundary, which is the only way it can be
            deterministic. Nothing should inherit a provider by accident.
        -->
        <env name="PAYMENT_GATEWAY" value=""/>
        <env name="DUITKU_MERCHANT_CODE" value=""/>
        <env name="DUITKU_API_KEY" value=""/>
        <env name="MIDTRANS_SERVER_KEY" value=""/>
        <env name="MIDTRANS_CLIENT_KEY" value=""/>
    </php>
</phpunit>
