#!/usr/bin/env bash
#
# ioms-ops -- the ONLY privileged command Hermes Agent may run on the IOMS host.
#
# Installed root-owned at /usr/local/bin/ioms-ops by install-ops-guard.sh, and
# reachable by the Hermes user through exactly one sudoers line:
#
#     <hermes-user> ALL=(root) NOPASSWD: /usr/local/bin/ioms-ops
#
# There is no shell passthrough. Every subcommand is listed below, every
# argument is validated against a pattern, and every call -- allowed,
# refused or failed -- is appended to /var/log/ioms-ops.log (append-only).
#
#   READ (runs immediately)      status | health [URL] | logs app|nginx|worker|migration [N]
#                                | git-status | disk | backup | backups
#   CHANGE (needs approval)      request deploy | request restart nginx|php8.3-fpm|ioms-worker
#                                | request rollback <commit>
#   EXECUTE an approved request  run <request-id>
#   APPROVE (a human, never the agent)  approve <request-id> | deny <request-id> | pending
#
# NOT AVAILABLE THROUGH THIS TOOL AT ALL, by design: restoring a backup over
# the live database, dropping or replacing data, editing .env, changing the
# firewall, DNS, users or packages, rebooting, reinstalling. Those are done
# by a person at a root shell.
#
# WHY APPROVAL IS SAFE AGAINST THE AGENT ITSELF: sudo sets SUDO_USER to the
# account that invoked it, and the agent cannot change that. `approve`
# refuses when SUDO_USER is the agent's user, so an agent can ask and can
# execute what a human approved -- never both ask and approve. An approval
# expires after 30 minutes and is bound to the exact commit it named, so a
# push between approval and execution cannot ride on it.

set -uo pipefail
umask 027

APP_DIR="${IOMS_APP_DIR:-/srv/ioms/app}"
APP_USER="${IOMS_APP_USER:-ioms}"
STATE=/var/lib/ioms-ops
AUDIT=/var/log/ioms-ops.log
CONF=/etc/ioms-ops.conf
HERMES_USER="hermes"
DEFAULT_URL="https://iomsuite.com"
APPROVAL_TTL=1800
[[ -r "$CONF" ]] && . "$CONF"   # HERMES_USER, DEFAULT_URL (root-owned, 644)

CALLER="${SUDO_USER:-$(id -un)}"
REQ_ID_RE='^[0-9]{8}-[0-9]{6}-[a-f0-9]{6}$'
SHA_RE='^[0-9a-f]{7,40}$'

[[ $EUID -eq 0 ]] || { echo "ioms-ops must run through sudo." >&2; exit 1; }
mkdir -p "$STATE/requests"; chmod 750 "$STATE"

audit() { # result exit-code detail...
    local result="$1" code="$2"; shift 2
    printf '{"time":"%s","caller":"%s","command":%s,"result":"%s","exit":%s}\n' \
        "$(date -Is)" "$CALLER" "$(printf '%s' "$ORIG_ARGS" | jq -Rs .)" "$result" "$code" >> "$AUDIT"
}
refuse() { echo "REFUSED: $*" >&2; audit refused 1; exit 1; }

# Removes anything shaped like a credential before log text leaves the host.
redact() {
    # Bearer FIRST: the generic rule would otherwise consume the word
    # "Bearer" as the value and leave the token itself in the output
    # (found by the rehearsal: "Authorization: [REDACTED] eyJ...").
    sed -E \
        -e 's/(Bearer )[A-Za-z0-9._~+\/=-]+/\1[REDACTED]/Ig' \
        -e 's/((password|passwd|secret|token|api[_-]?key|signature)["'"'"' ]*[:=] *)"[^"]*"/\1"[REDACTED]"/Ig' \
        -e "s/((password|passwd|secret|token|api[_-]?key|signature)[\"' ]*[:=] *)'[^']*'/\1'[REDACTED]'/Ig" \
        -e 's/((password|passwd|secret|token|api[_-]?key|authorization|signature)["'"'"' ]*[:=][ "'"'"']*)(Bearer \[REDACTED\]|"\[REDACTED\]"|'"'"'\[REDACTED\]'"'"'|[^ ,"'"'"'&]+)/\1[REDACTED]/Ig' \
        -e 's/(mysql:\/\/[^:]+:)[^@]+@/\1[REDACTED]@/g'
}

as_app() { sudo -u "$APP_USER" -H bash -c "cd '$APP_DIR' && $*"; }

ORIG_ARGS="$*"
cmd="${1:-help}"; shift || true

# ------------------------------------------------------------------ read
do_status() {
    echo "commit:   $(git -c safe.directory="$APP_DIR" -C "$APP_DIR" log -1 --format='%h %s (%cr)' 2>/dev/null)"
    echo "branch:   $(git -c safe.directory="$APP_DIR" -C "$APP_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null)"
    echo "version:  $(as_app "php artisan tinker --execute='echo config(\"ioms.version\");'" 2>/dev/null)"
    echo "worker:   $(supervisorctl status ioms-worker 2>/dev/null | awk '{print $2}')"
    for s in nginx php8.3-fpm mysql; do echo "$(printf '%-9s' "$s:") $(pgrep -f "$s" >/dev/null && echo running || echo DOWN)"; done
    echo "load:     $(cut -d' ' -f1-3 /proc/loadavg)   mem free: $(free -m | awk '/Mem:/ {print $7}') MB"
    echo "disk /:   $(df -h / | awk 'NR==2 {print $5" used"}')"
    echo "backup:   $(ls -1d /var/backups/ioms/*/ 2>/dev/null | tail -1 || echo none)"
}

do_logs() {
    local which="${1:-app}" n="${2:-100}" file
    [[ "$n" =~ ^[0-9]{1,4}$ ]] || refuse "N must be a number up to 9999"
    case "$which" in
        app) file="$(ls -1t "$APP_DIR"/storage/logs/*.log 2>/dev/null | head -1)" ;;
        nginx) file=/var/log/nginx/error.log ;;
        worker) file="$APP_DIR/storage/logs/worker.log" ;;
        migration) file=/var/log/ioms-migration.log ;;
        *) refuse "logs: app|nginx|worker|migration" ;;
    esac
    [[ -r "$file" ]] || { echo "(no $which log)"; return 0; }
    tail -n "$n" "$file" | redact
}

do_health() {
    local url="${1:-$DEFAULT_URL}"
    [[ "$url" =~ ^https?://[A-Za-z0-9.-]+(:[0-9]+)?/?$ ]] || refuse "health: URL must be scheme://host"
    bash /usr/local/lib/ioms-ops/healthcheck.sh "$url"
}

# ------------------------------------------------------------------ change
new_request() { # action target
    local id; id="$(date +%Y%m%d-%H%M%S)-$(openssl rand -hex 3)"
    local current target_commit=""
    current="$(git -c safe.directory="$APP_DIR" -C "$APP_DIR" rev-parse HEAD)"
    case "$1" in
        deploy)
            as_app "git fetch -q origin main" || refuse "git fetch failed"
            target_commit="$(git -c safe.directory="$APP_DIR" -C "$APP_DIR" rev-parse origin/main)"
            [[ "$target_commit" != "$current" ]] || { echo "Already at origin/main ($current). Nothing to deploy."; audit noop 0; exit 0; }
            ;;
        rollback) target_commit="$(git -c safe.directory="$APP_DIR" -C "$APP_DIR" rev-parse "$2^{commit}" 2>/dev/null)" || refuse "unknown commit $2" ;;
        restart) target_commit="" ;;
    esac
    jq -n --arg id "$id" --arg action "$1" --arg arg "${2:-}" --arg by "$CALLER" \
          --arg current "$current" --arg target "$target_commit" --arg at "$(date +%s)" \
          '{id:$id, action:$action, arg:$arg, requested_by:$by, requested_at:($at|tonumber),
            current_commit:$current, target_commit:$target, status:"pending"}' > "$STATE/requests/$id.json"
    echo "Request $id created: $1 ${2:-}"
    if [[ -n "$target_commit" ]]; then
        echo "From $current to $target_commit:"
        git -c safe.directory="$APP_DIR" -C "$APP_DIR" log --oneline "$current..$target_commit" 2>/dev/null | head -20
        git -c safe.directory="$APP_DIR" -C "$APP_DIR" diff --stat "$current" "$target_commit" 2>/dev/null | tail -1
        if git -c safe.directory="$APP_DIR" -C "$APP_DIR" diff --name-only "$current" "$target_commit" 2>/dev/null | grep -q '^database/migrations/'; then
            echo "NOTE: this change includes DATABASE MIGRATIONS."
        fi
    fi
    echo "A person must approve it:  sudo ioms-ops approve $id"
}

load_request() {
    [[ "$1" =~ $REQ_ID_RE ]] || refuse "bad request id"
    REQ="$STATE/requests/$1.json"
    [[ -f "$REQ" ]] || refuse "no such request $1"
}

do_approve() {
    load_request "$1"
    [[ "$CALLER" != "$HERMES_USER" ]] || refuse "the agent account cannot approve its own requests"
    [[ "$(jq -r .status "$REQ")" == pending ]] || refuse "request is $(jq -r .status "$REQ")"
    jq --arg by "$CALLER" --arg at "$(date +%s)" '.status="approved" | .approved_by=$by | .approved_at=($at|tonumber)' "$REQ" > "$REQ.tmp" && mv "$REQ.tmp" "$REQ"
    echo "Approved $1 ($(jq -r '.action+" "+.arg' "$REQ")). Valid for $((APPROVAL_TTL / 60)) minutes."
}

do_deny() {
    load_request "$1"
    [[ "$CALLER" != "$HERMES_USER" ]] || refuse "the agent account cannot decide requests"
    jq --arg by "$CALLER" '.status="denied" | .denied_by=$by' "$REQ" > "$REQ.tmp" && mv "$REQ.tmp" "$REQ"
    echo "Denied $1."
}

do_run() {
    load_request "$1"
    [[ "$(jq -r .status "$REQ")" == approved ]] || refuse "request $1 is $(jq -r .status "$REQ"), not approved"
    local age=$(( $(date +%s) - $(jq -r .approved_at "$REQ") ))
    [[ $age -le $APPROVAL_TTL ]] || { jq '.status="expired"' "$REQ" > "$REQ.tmp" && mv "$REQ.tmp" "$REQ"; refuse "approval expired ${age}s ago"; }
    [[ "$(git -c safe.directory="$APP_DIR" -C "$APP_DIR" rev-parse HEAD)" == "$(jq -r .current_commit "$REQ")" ]] || refuse "the server moved since the request was made; request again"

    local action arg target rc=0
    action="$(jq -r .action "$REQ")"; arg="$(jq -r .arg "$REQ")"; target="$(jq -r .target_commit "$REQ")"
    jq '.status="running"' "$REQ" > "$REQ.tmp" && mv "$REQ.tmp" "$REQ"

    case "$action" in
        deploy|rollback)
            echo "Backing up before $action ..."
            /usr/local/bin/ioms-backup || { rc=1; }
            if [[ $rc -eq 0 ]]; then
                if [[ "$action" == deploy ]]; then
                    as_app "git fetch -q origin main && test \"\$(git rev-parse origin/main)\" = '$target'" \
                        || { echo "origin/main moved since approval; request again." >&2; rc=1; }
                    [[ $rc -eq 0 ]] && { as_app "./deploy.sh" 2>&1 | redact; rc=${PIPESTATUS[0]}; }
                else
                    as_app "git checkout -q -B main '$target'" && { as_app "composer install --no-dev --optimize-autoloader -q && php artisan app:deploy" 2>&1 | redact; rc=${PIPESTATUS[0]}; } || rc=1
                    echo "NOTE: rollback moves CODE only. Migrations already applied are not reversed."
                fi
                supervisorctl restart ioms-worker >/dev/null 2>&1 || true
            fi
            ;;
        restart)
            case "$arg" in
                nginx|php8.3-fpm) (systemctl restart "$arg" 2>/dev/null || service "$arg" restart); rc=$? ;;
                ioms-worker) supervisorctl restart ioms-worker; rc=$? ;;
                *) rc=1 ;;
            esac
            ;;
    esac

    jq --arg rc "$rc" --arg at "$(date +%s)" '.status=(if $rc=="0" then "done" else "failed" end) | .exit=($rc|tonumber) | .finished_at=($at|tonumber)' "$REQ" > "$REQ.tmp" && mv "$REQ.tmp" "$REQ"
    echo "Request $1: $([[ $rc -eq 0 ]] && echo done || echo FAILED)"
    return $rc
}

do_pending() {
    shopt -s nullglob
    for f in "$STATE"/requests/*.json; do
        jq -r 'select(.status=="pending" or .status=="approved") | "\(.id)  \(.status)  \(.action) \(.arg)  by \(.requested_by)  target \(.target_commit[0:7])"' "$f"
    done
}

# ------------------------------------------------------------------ dispatch
rc=0
case "$cmd" in
    status) do_status ;;
    logs) do_logs "$@" ;;
    health) do_health "$@" ;;
    git-status) git -c safe.directory="$APP_DIR" -C "$APP_DIR" status --short --branch; git -c safe.directory="$APP_DIR" -C "$APP_DIR" log --oneline -5 ;;
    disk) df -h / /var; du -sh /var/backups/ioms "$APP_DIR/storage" 2>/dev/null ;;
    backup) /usr/local/bin/ioms-backup ;;
    backups) ls -1d /var/backups/ioms/*/ 2>/dev/null | tail -14 ;;
    request)
        case "${1:-}" in
            deploy) new_request deploy ;;
            restart) [[ "${2:-}" =~ ^(nginx|php8\.3-fpm|ioms-worker)$ ]] || refuse "restart: nginx|php8.3-fpm|ioms-worker"; new_request restart "$2" ;;
            rollback) [[ "${2:-}" =~ $SHA_RE ]] || refuse "rollback needs a commit sha"; new_request rollback "$2" ;;
            *) refuse "request: deploy | restart <service> | rollback <commit>" ;;
        esac ;;
    run) do_run "${1:-}" ;;
    approve) do_approve "${1:-}" ;;
    deny) do_deny "${1:-}" ;;
    pending) do_pending ;;
    help|-h|--help) sed -n '2,32p' "$0" ;;
    *) refuse "unknown command '$cmd' (see: ioms-ops help)" ;;
esac
rc=$?
audit "$([[ $rc -eq 0 ]] && echo ok || echo failed)" "$rc"
exit $rc
