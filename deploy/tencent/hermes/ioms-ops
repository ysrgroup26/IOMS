#!/usr/bin/env bash
#
# ioms-ops -- what Hermes Agent may do as root on the IOMS host.
#
# Installed root-owned at /usr/local/bin/ioms-ops by install-ops-guard.sh and
# reachable by the agent account through ONE sudoers line:
#
#     <agent> ALL=(root) NOPASSWD: /usr/local/bin/ioms-ops
#
# DESIGN: the agent is meant to be USEFUL. Routine operations run on their own,
# protected by automatic guard rails (tests, backups, health checks, automatic
# rollback, rate limits) instead of by a person. A person is asked only for the
# few operations whose failure cannot be undone automatically. Nothing gives a
# shell, the database or the secrets.
#
# AUTONOMOUS (no approval)
#   status | release-json | health [URL] | policy
#   logs app|worker|nginx|nginx-access|php|backup|migration|ops [N]   (secrets and tokens redacted)
#   git-status | disk | db-stats | backups | backup
#   deploy [sha]      fast-forward to origin/main (or to <sha>, which must be on
#                     origin/main): tests on the target commit, backup, deploy,
#                     health check, AUTOMATIC ROLLBACK if it fails. New migrations
#                     are autonomous only when ALL are additive (migration-policy.php,
#                     ADR 076); anything else needs `request deploy`. Every attempt leaves its outcome in
#                     /var/lib/ioms-ops/last-deploy.json for ioms-release-watch.
#   restart nginx|php8.3-fpm|ioms-worker|mysql (nginx/php-fpm config-tested first)
#   artisan <allowed command> [args]           (see `ioms-ops policy`)
#   maintenance off                            (bring the site back up)
#
# NEEDS A PERSON (request -> approve by someone who is not the agent -> run)
#   request deploy            for a change WITH migrations
#   request rollback <sha>    to a commit that is not the last good deploy
#   request maintenance-on
#   run <id> | pending | approve <id> | deny <id>
#
# NOT AVAILABLE AT ALL: a shell, tinker, raw SQL, .env, restoring over the live
# database, dropping data, firewall, DNS, users, packages, reboot, reinstall.
#
# Every call -- allowed, refused or failed -- is one JSON line in
# /var/log/ioms-ops.log (append-only).

set -uo pipefail
umask 027

APP_DIR="${IOMS_APP_DIR:-/srv/ioms/app}"
APP_USER="${IOMS_APP_USER:-ioms}"
STATE=/var/lib/ioms-ops
AUDIT=/var/log/ioms-ops.log
CONF=/etc/ioms-ops.conf
HERMES_USER="hermes"
DEFAULT_URL="https://iomsuite.com"
APPROVAL_TTL=1800
MAX_DEPLOYS_PER_HOUR=6
MAX_RESTARTS_PER_HOUR=12
TEST_GATE=on
# ADR 076: a release whose new migrations are ALL additive (new tables, nullable or
# defaulted columns, indexes) deploys without a person; anything else still needs
# `request deploy`. `off` restores "every migration needs a person".
AUTO_MIGRATIONS=additive
MIGRATION_POLICY=/usr/local/lib/ioms-ops/migration-policy.php
[[ -r "$CONF" ]] && . "$CONF"   # root-owned, 644: HERMES_USER, DEFAULT_URL, limits, TEST_GATE, AUTO_MIGRATIONS

CALLER="${SUDO_USER:-$(id -un)}"
REQ_ID_RE='^[0-9]{8}-[0-9]{6}-[a-f0-9]{6}$'
SHA_RE='^[0-9a-f]{7,40}$'
G=(git -c safe.directory="$APP_DIR" -C "$APP_DIR")

[[ $EUID -eq 0 ]] || { echo "ioms-ops must run through sudo." >&2; exit 1; }
mkdir -p "$STATE/requests" "$STATE/rate"; chmod 750 "$STATE"

ORIG_ARGS="$*"
audit() {
    printf '{"time":"%s","caller":"%s","command":%s,"result":"%s","exit":%s}\n' \
        "$(date -Is)" "$CALLER" "$(printf '%s' "$ORIG_ARGS" | jq -Rs .)" "$1" "$2" >> "$AUDIT"
}
refuse() { echo "REFUSED: $*" >&2; audit refused 1; exit 1; }

# Credentials and bearer tokens, plus the IOMS URLs whose path IS a credential
# (order status, verification, signed links).
redact() {
    sed -E \
        -e 's/(Bearer )[A-Za-z0-9._~+\/=-]+/\1[REDACTED]/Ig' \
        -e 's/((password|passwd|secret|token|api[_-]?key|signature)["'"'"' ]*[:=] *)"[^"]*"/\1"[REDACTED]"/Ig' \
        -e "s/((password|passwd|secret|token|api[_-]?key|signature)[\"' ]*[:=] *)'[^']*'/\1'[REDACTED]'/Ig" \
        -e 's/((password|passwd|secret|token|api[_-]?key|authorization|signature)["'"'"' ]*[:=][ "'"'"']*)(Bearer \[REDACTED\]|"\[REDACTED\]"|'"'"'\[REDACTED\]'"'"'|[^ ,"'"'"'&]+)/\1[REDACTED]/Ig' \
        -e 's/(mysql:\/\/[^:]+:)[^@]+@/\1[REDACTED]@/g' \
        -e 's#(/get-started/(verify/)?)[A-Za-z0-9]{16,}#\1[TOKEN]#g' \
        -e 's#(/(reset-password|email/verify|verify-email)/)[^ ?"]+#\1[TOKEN]#g' \
        -e 's#([?&](signature|token|expires|hash)=)[^ &"]+#\1[REDACTED]#g'
}

as_app() { sudo -u "$APP_USER" -H bash -c "cd '$APP_DIR' && $*"; }
# During the migration the queue worker is HELD (migrate-all.sh): a copy of
# production must not process customers' jobs before the cutover.
held() { [[ -f /var/lib/ioms-migrate/hold ]]; }
worker_restart() { held && { echo "  worker held for the migration -- not restarted"; return 0; }; supervisorctl restart ioms-worker >/dev/null 2>&1 || true; }
head_sha() { "${G[@]}" rev-parse HEAD; }

rate_ok() { # bucket limit -- sliding hour
    local f="$STATE/rate/$1" now; now="$(date +%s)"
    touch "$f"; awk -v n="$now" '$1 > n-3600' "$f" > "$f.tmp"; mv "$f.tmp" "$f"
    [[ "$(wc -l < "$f")" -lt "$2" ]] || return 1
    echo "$now" >> "$f"
}

local_health() { # against this host, keeping the real name for TLS/SNI
    bash /usr/local/lib/ioms-ops/healthcheck.sh "$DEFAULT_URL" --resolve 127.0.0.1 --insecure
}

# ------------------------------------------------------------------ read
do_status() {
    echo "commit:   $("${G[@]}" log -1 --format='%h %s (%cr)' 2>/dev/null)"
    echo "branch:   $("${G[@]}" rev-parse --abbrev-ref HEAD 2>/dev/null)"
    echo "version:  $(as_app "php artisan tinker --execute='echo config(\"ioms.version\");'" 2>/dev/null)"
    echo "worker:   $(supervisorctl status ioms-worker 2>/dev/null | awk '{print $2}')"
    for s in nginx php-fpm mysqld; do echo "$(printf '%-9s' "$s:") $(pgrep -x "$s" >/dev/null || pgrep -f "$s:" >/dev/null && echo running || echo DOWN)"; done
    echo "load:     $(cut -d' ' -f1-3 /proc/loadavg)   mem available: $(free -m | awk '/Mem:/ {print $7}') MB"
    echo "disk /:   $(df -h / | awk 'NR==2 {print $5" used, "$4" free"}')"
    echo "backup:   $(ls -1d /var/backups/ioms/*/ 2>/dev/null | tail -1 || echo none)"
    echo "last good deploy: $(cat "$STATE/last-good" 2>/dev/null || echo unknown)"
}

# One JSON object: what is running and how the last deploy attempt ended. Read by
# ioms-ci-deploy so GitHub records the result; contains no secret.
do_release_json() {
    jq -cn --arg head "$(head_sha)" --arg good "$(cat "$STATE/last-good" 2>/dev/null)" \
        --argjson last "$(cat "$STATE/last-deploy.json" 2>/dev/null || echo null)" \
        --arg held "$(held && echo true || echo false)" \
        '{running:$head, last_good:$good, last_deploy:$last, migration_hold:($held=="true")}'
}

do_logs() {
    local which="${1:-app}" n="${2:-200}" file
    [[ "$n" =~ ^[0-9]{1,5}$ ]] || refuse "N must be a number"
    case "$which" in
        app) file="$(ls -1t "$APP_DIR"/storage/logs/laravel*.log 2>/dev/null | head -1)" ;;
        worker) file="$APP_DIR/storage/logs/worker.log" ;;
        nginx) file=/var/log/nginx/error.log ;;
        nginx-access) file=/var/log/nginx/access.log ;;
        php) file=/var/log/php8.3-fpm-ioms.log ;;
        backup) file=/var/log/ioms-backup.log ;;
        migration) file=/var/log/ioms-migration.log ;;
        ops) file="$AUDIT" ;;
        *) refuse "logs: app|worker|nginx|nginx-access|php|backup|migration|ops" ;;
    esac
    [[ -r "$file" ]] || { echo "(no $which log)"; return 0; }
    tail -n "$n" "$file" | redact
}

do_db_stats() {
    # Counts and sizes only -- never row contents.
    local q="SELECT table_name, table_rows, ROUND((data_length+index_length)/1048576,1) AS mb
             FROM information_schema.tables WHERE table_schema='ioms' ORDER BY (data_length+index_length) DESC LIMIT 25"
    mysql --defaults-extra-file=/root/ioms-db.cnf -t -e "$q"
    mysql --defaults-extra-file=/root/ioms-db.cnf -N -e "SELECT 'jobs pending', COUNT(*) FROM ioms.jobs; SELECT 'jobs failed', COUNT(*) FROM ioms.failed_jobs; SELECT 'migrations applied', COUNT(*) FROM ioms.migrations;" 2>/dev/null
}

do_policy() {
    cat <<EOF
Autonomous: status health policy logs git-status disk db-stats backups backup
            deploy [sha] (tests + backup + health + auto-rollback; ${MAX_DEPLOYS_PER_HOUR}/hour;
                    migrations only when all additive: AUTO_MIGRATIONS=${AUTO_MIGRATIONS})
            restart nginx|php8.3-fpm|ioms-worker|mysql (${MAX_RESTARTS_PER_HOUR}/hour)
            maintenance off
            artisan: ${ARTISAN_ALLOWED[*]}
Approval:   request deploy (non-additive migrations) | request rollback <sha> | request maintenance-on
Never:      shell, tinker, raw SQL, .env, restore over live DB, firewall, DNS, users, packages, reboot
Test gate:  ${TEST_GATE}
EOF
}

# ------------------------------------------------------------------ artisan
ARTISAN_ALLOWED=(about migrate:status route:list schedule:list schedule:run queue:failed queue:retry
    queue:restart config:cache config:clear cache:clear route:cache route:clear view:cache view:clear
    event:cache event:clear optimize optimize:clear storage:link ioms:mail-check ioms:duitku-check)

do_artisan() {
    local c="${1:-}"; shift || true
    [[ " ${ARTISAN_ALLOWED[*]} " == *" $c "* ]] || refuse "artisan '$c' is not on the list (ioms-ops policy)"
    local a
    for a in "$@"; do
        [[ "$a" =~ ^[A-Za-z0-9@._:=/-]{1,120}$ ]] || refuse "argument '$a' has characters outside [A-Za-z0-9@._:=/-]"
        [[ "$a" != --env* && "$a" != --database* ]] || refuse "--env/--database are not allowed"
    done
    # Only quote what exists: printf '%q ' with no arguments yields '' -- an
    # empty argument that made every bare artisan command fail.
    local args=""; [[ $# -gt 0 ]] && args="$(printf '%q ' "$@")"
    as_app "php artisan $c $args" 2>&1 | redact
    return "${PIPESTATUS[0]}"
}

# ------------------------------------------------------------------ restart
do_restart() {
    case "${1:-}" in
        # reload-or-restart: a plain reload does nothing to an nginx that is down.
        nginx) nginx -t 2>&1 | tail -1 && { systemctl reload-or-restart nginx 2>/dev/null || { service nginx status >/dev/null 2>&1 && service nginx reload || service nginx start; }; } ;;
        php8.3-fpm) php-fpm8.3 -t 2>&1 | tail -1 && { systemctl restart php8.3-fpm 2>/dev/null || service php8.3-fpm restart; } ;;
        ioms-worker) held && refuse "the worker is held for the migration (migrate-all.sh go-live releases it)"; supervisorctl restart ioms-worker ;;
        mysql) systemctl restart mysql 2>/dev/null || service mysql restart ;;
        *) refuse "restart: nginx|php8.3-fpm|ioms-worker|mysql" ;;
    esac
}

# ------------------------------------------------------------------ deploy
# Classifies the migrations between two commits. The classifier is root-owned and
# installed (never read from the checkout), and runs as the APP USER on the file
# contents piped in -- repository code is never executed, and never as root.
migration_policy() { # from to -> 0 only when every changed migration is judged additive
    [[ -r "$MIGRATION_POLICY" ]] || { echo "  migration policy not installed -- treating as needs approval"; return 1; }
    local from="$1" to="$2" verdict
    # FAIL CLOSED, decided from the classifier's OUTPUT rather than an exit status read out of
    # a pipeline (an earlier version read PIPESTATUS of the wrong element, saw the while-loop's
    # 0, and let a dropColumn through -- found by the ADR 076 rehearsal). Anything other than
    # one "additive" line per changed file -- review, no output, a crash -- needs a person.
    verdict="$("${G[@]}" diff --name-status "$from" "$to" -- database/migrations/ | while IFS=$'\t' read -r status path rest; do
        [[ "$status" == R* && -n "$rest" ]] && path="$rest"
        printf '==== %s %s\n' "${status:0:1}" "$path"
        [[ "$status" == D ]] || "${G[@]}" show "$to:$path" 2>/dev/null
        printf '\n'
    done | sudo -u "$APP_USER" php "$MIGRATION_POLICY" 2>&1)"
    printf '%s\n' "$verdict" | sed 's/^/  migration: /'
    local changed judged
    changed="$("${G[@]}" diff --name-only "$from" "$to" -- database/migrations/ | grep -c .)"
    judged="$(printf '%s\n' "$verdict" | grep -c '^additive ')"
    [[ "$changed" -gt 0 && "$judged" -eq "$changed" ]] && ! printf '%s\n' "$verdict" | grep -qv '^additive '
}

test_gate() { # sha -- run the suite on the TARGET commit, in-memory SQLite, never the live DB
    [[ "$TEST_GATE" == on ]] || { echo "  test gate: off"; return 0; }
    # Under the app user's own tree: $STATE is root-only and the suite runs as $APP_USER.
    local sha="$1" ci; ci="$(dirname "$APP_DIR")/ci"; local wt="$ci/$1"
    install -d -m 750 -o "$APP_USER" -g "$APP_USER" "$ci"; rm -rf "$wt"
    echo "  test gate: suite on ${sha:0:7} (in-memory SQLite) ..."
    sudo -u "$APP_USER" -H bash -c "
        set -eo pipefail   # the suite's exit status, not tail's (a failing test once passed this gate)
        git -C '$APP_DIR' worktree add --detach -f '$wt' '$sha' >/dev/null 2>&1
        cd '$wt'
        cp '$APP_DIR/.env.example' .env
        composer install -q --no-interaction --no-progress >/dev/null 2>&1
        nice -n 10 php artisan test --compact > '$wt.out' 2>&1 || { grep -E 'FAILED|Tests:' '$wt.out' | head -20; exit 1; }
        grep -E 'Tests:|Duration' '$wt.out'
    " ; local rc=$?
    sudo -u "$APP_USER" git -C "$APP_DIR" worktree remove --force "$wt" >/dev/null 2>&1 || rm -rf "$wt"
    rm -f "$wt.out"
    return $rc
}

# The machine-readable result of the last deploy attempt (ADR 075). One of:
# deployed noop tests_failed needs_approval rate_limited locked fetch_failed
# not_fast_forward bad_target backup_failed deploy_failed rolled_back
# rollback_failed unhealthy_held
outcome() { # outcome target
    jq -n --arg t "$(date -Is)" --arg o "$1" --arg sha "${2:-}" --arg by "$CALLER" \
        '{time:$t, outcome:$o, target:$sha, caller:$by}' > "$STATE/last-deploy.json.tmp" \
        && mv "$STATE/last-deploy.json.tmp" "$STATE/last-deploy.json"
}
deploy_refuse() { outcome "$1" "${3:-}"; refuse "$2"; }

deploy_to() { # target-sha previous-sha allow-auto-rollback(0|1)
    local target="$1" prev="$2" auto_rb="$3"
    echo "  backup ..."; /usr/local/bin/ioms-backup >/dev/null || { echo "  backup FAILED -- not deploying"; outcome backup_failed "$target"; return 1; }
    echo "  deploying ${target:0:7} ..."
    # NOT ./deploy.sh: its first step is `git pull`, which moved the checkout past the
    # tested commit to whatever origin/main had become -- the release that went live was
    # not the one the test gate passed, and migrations ran that the migration policy never
    # saw (found by the ADR 076 rehearsal). The two steps after the pull are run here, on
    # exactly $target, the same way the rollback below already does it.
    as_app "git checkout -q -B main '$target'" || { echo "  checkout FAILED -- nothing deployed"; outcome deploy_failed "$target"; return 1; }
    [[ "$(head_sha)" == "$target" ]] || { echo "  checkout is at $(head_sha | cut -c1-7), not ${target:0:7} -- stopping"; outcome deploy_failed "$target"; return 1; }
    as_app "composer install --no-dev --optimize-autoloader --no-interaction -q && php artisan app:deploy" 2>&1 | redact | grep -E 'signature|Deployment complete|ERROR|Error|FAIL|Migrat' || true
    if [[ "$(head_sha)" != "$target" ]]; then
        echo "  the checkout moved during the deploy (now $(head_sha | cut -c1-7)) -- treating as unhealthy"
    fi
    worker_restart
    echo "  health check ..."
    if [[ "$(head_sha)" == "$target" ]] && local_health > "$STATE/last-health.txt" 2>&1; then
        echo "  healthy -- ${target:0:7} is live"; echo "$target" > "$STATE/last-good"; outcome deployed "$target"; return 0
    fi
    grep FAIL "$STATE/last-health.txt" | sed 's/^/    /'
    if [[ "$auto_rb" == 1 ]]; then
        echo "  UNHEALTHY -- rolling back automatically to ${prev:0:7}"
        as_app "git checkout -q -B main '$prev' && composer install --no-dev --optimize-autoloader -q && php artisan app:deploy" >/dev/null 2>&1
        worker_restart
        if local_health >/dev/null 2>&1; then echo "  rolled back; ${prev:0:7} is live and healthy"; outcome rolled_back "$target"
        else echo "  ROLLBACK ALSO UNHEALTHY -- a person must look now"; outcome rollback_failed "$target"; fi
    else
        echo "  UNHEALTHY -- not rolled back automatically (this deploy ran migrations). A person must decide."
        outcome unhealthy_held "$target"
    fi
    return 1
}

do_deploy_auto() { # [sha] -- default origin/main
    exec 9>"$STATE/deploy.lock"; flock -n 9 || deploy_refuse locked "another deploy is running"
    as_app "git fetch -q origin main" || deploy_refuse fetch_failed "git fetch failed"
    local cur target; cur="$(head_sha)"; target="$("${G[@]}" rev-parse origin/main)"
    if [[ -n "${1:-}" ]]; then
        # A specific commit -- the one CI passed (ioms-release-watch). It must
        # already be on origin/main: this is never a way to deploy a branch.
        [[ "$1" =~ $SHA_RE ]] || deploy_refuse bad_target "deploy: not a commit id"
        target="$("${G[@]}" rev-parse --verify -q "$1^{commit}")" || deploy_refuse bad_target "unknown commit $1" "$1"
        "${G[@]}" merge-base --is-ancestor "$target" origin/main || deploy_refuse bad_target "${target:0:7} is not on origin/main" "$target"
    fi
    [[ "$target" != "$cur" ]] || { echo "Already at ${cur:0:7}."; outcome noop "$target"; return 0; }
    "${G[@]}" merge-base --is-ancestor "$cur" "$target" || deploy_refuse not_fast_forward "${target:0:7} is not a fast-forward of ${cur:0:7} (history rewritten?) -- request deploy" "$target"
    if "${G[@]}" diff --name-only "$cur" "$target" | grep -q '^database/migrations/'; then
        if [[ "$AUTO_MIGRATIONS" == additive ]] && migration_policy "$cur" "$target"; then
            echo "  migrations: additive only -- autonomous (backup is taken before they run)"
        else
            deploy_refuse needs_approval "this change has DATABASE MIGRATIONS that are not purely additive -- not autonomous. Use: ioms-ops request deploy" "$target"
        fi
    fi
    rate_ok deploy "$MAX_DEPLOYS_PER_HOUR" || deploy_refuse rate_limited "deploy limit reached (${MAX_DEPLOYS_PER_HOUR}/hour)" "$target"
    echo "Deploy ${cur:0:7} -> ${target:0:7}:"; "${G[@]}" log --oneline "$cur..$target" | head -10 | sed 's/^/  /'
    test_gate "$target" || deploy_refuse tests_failed "tests FAILED on ${target:0:7}; nothing was deployed" "$target"
    deploy_to "$target" "$cur" 1
}

# ------------------------------------------------------------------ approval
new_request() { # action [arg]
    local id cur target=""; id="$(date +%Y%m%d-%H%M%S)-$(openssl rand -hex 3)"; cur="$(head_sha)"
    case "$1" in
        deploy) as_app "git fetch -q origin main" || refuse "git fetch failed"; target="$("${G[@]}" rev-parse origin/main)"
                [[ "$target" != "$cur" ]] || { echo "Already at origin/main."; audit noop 0; exit 0; } ;;
        rollback) target="$("${G[@]}" rev-parse "$2^{commit}" 2>/dev/null)" || refuse "unknown commit $2" ;;
    esac
    jq -n --arg id "$id" --arg action "$1" --arg arg "${2:-}" --arg by "$CALLER" --arg current "$cur" \
          --arg target "$target" --arg at "$(date +%s)" \
          '{id:$id, action:$action, arg:$arg, requested_by:$by, requested_at:($at|tonumber), current_commit:$current, target_commit:$target, status:"pending"}' \
          > "$STATE/requests/$id.json"
    echo "Request $id: $1 ${2:-}"
    if [[ -n "$target" ]]; then
        "${G[@]}" log --oneline "$cur..$target" 2>/dev/null | head -15 | sed 's/^/  /'
        "${G[@]}" diff --name-only "$cur" "$target" 2>/dev/null | grep '^database/migrations/' | sed 's/^/  MIGRATION /'
    fi
    echo "A person approves it with:  sudo ioms-ops approve $id"
}

load_request() {
    [[ "${1:-}" =~ $REQ_ID_RE ]] || refuse "bad request id"
    REQ="$STATE/requests/$1.json"; [[ -f "$REQ" ]] || refuse "no such request $1"
}
set_req() { jq "$@" "$REQ" > "$REQ.tmp" && mv "$REQ.tmp" "$REQ"; }

do_approve() {
    load_request "$1"
    [[ "$CALLER" != "$HERMES_USER" ]] || refuse "the agent account cannot approve its own requests"
    [[ "$(jq -r .status "$REQ")" == pending ]] || refuse "request is $(jq -r .status "$REQ")"
    set_req --arg by "$CALLER" --arg at "$(date +%s)" '.status="approved" | .approved_by=$by | .approved_at=($at|tonumber)'
    echo "Approved $1 ($(jq -r '.action+" "+.arg' "$REQ")). The agent may run it within $((APPROVAL_TTL / 60)) minutes."
}

do_deny() {
    load_request "$1"; [[ "$CALLER" != "$HERMES_USER" ]] || refuse "the agent account cannot decide requests"
    set_req --arg by "$CALLER" '.status="denied" | .denied_by=$by'; echo "Denied $1."
}

do_run() {
    load_request "$1"
    [[ "$(jq -r .status "$REQ")" == approved ]] || refuse "request $1 is $(jq -r .status "$REQ"), not approved"
    local age=$(( $(date +%s) - $(jq -r .approved_at "$REQ") ))
    [[ $age -le $APPROVAL_TTL ]] || { set_req '.status="expired"'; refuse "approval expired ${age}s ago"; }
    [[ "$(head_sha)" == "$(jq -r .current_commit "$REQ")" ]] || refuse "the server moved since the request; request again"
    exec 9>"$STATE/deploy.lock"; flock -n 9 || refuse "another deploy is running"
    local action target cur rc=0; action="$(jq -r .action "$REQ")"; target="$(jq -r .target_commit "$REQ")"; cur="$(head_sha)"
    set_req '.status="running"'
    case "$action" in
        deploy)
            as_app "git fetch -q origin main"
            [[ "$("${G[@]}" rev-parse origin/main)" == "$target" ]] || { set_req '.status="stale"'; refuse "origin/main moved since approval"; }
            test_gate "$target" || { set_req '.status="failed"'; refuse "tests FAILED on ${target:0:7}"; }
            deploy_to "$target" "$cur" 0; rc=$? ;;
        rollback)
            deploy_to "$target" "$cur" 0; rc=$?
            echo "  NOTE: a rollback moves CODE only; migrations already applied stay applied." ;;
        maintenance-on)
            as_app "php artisan down --retry=60"; rc=$? ;;
    esac
    set_req --arg rc "$rc" '.status=(if $rc=="0" then "done" else "failed" end) | .exit=($rc|tonumber)'
    return $rc
}

do_pending() {
    shopt -s nullglob
    for f in "$STATE"/requests/*.json; do
        jq -r 'select(.status=="pending" or .status=="approved") | "\(.id)  \(.status)  \(.action) \(.arg)  by \(.requested_by)  target \(.target_commit[0:7])"' "$f"
    done
}

# ------------------------------------------------------------------ dispatch
cmd="${1:-help}"; shift || true
case "$cmd" in
    status) do_status ;;
    release-json) do_release_json ;;
    health) url="${1:-$DEFAULT_URL}"; [[ "$url" =~ ^https?://[A-Za-z0-9.-]+(:[0-9]+)?/?$ ]] || refuse "health: URL must be scheme://host"
            if [[ "$url" == "$DEFAULT_URL" ]]; then local_health; else bash /usr/local/lib/ioms-ops/healthcheck.sh "$url"; fi ;;
    policy) do_policy ;;
    logs) do_logs "$@" ;;
    git-status) "${G[@]}" status --short --branch; "${G[@]}" log --oneline -8 ;;
    disk) df -h / /var; du -sh /var/backups/ioms "$APP_DIR/storage" 2>/dev/null ;;
    db-stats) do_db_stats ;;
    backup) /usr/local/bin/ioms-backup ;;
    backups) ls -1d /var/backups/ioms/*/ 2>/dev/null | tail -14 ;;
    deploy) do_deploy_auto "${1:-}" ;;
    restart) rate_ok restart "$MAX_RESTARTS_PER_HOUR" || refuse "restart limit reached (${MAX_RESTARTS_PER_HOUR}/hour)"; do_restart "${1:-}" ;;
    artisan) do_artisan "$@" ;;
    maintenance)
        case "${1:-}" in
            off) as_app "php artisan up" ;;
            on) refuse "maintenance on takes the site down -- use: ioms-ops request maintenance-on" ;;
            *) refuse "maintenance off | request maintenance-on" ;;
        esac ;;
    request)
        case "${1:-}" in
            deploy) new_request deploy ;;
            rollback) [[ "${2:-}" =~ $SHA_RE ]] || refuse "rollback needs a commit sha"; new_request rollback "$2" ;;
            maintenance-on) new_request maintenance-on ;;
            *) refuse "request: deploy | rollback <sha> | maintenance-on" ;;
        esac ;;
    run) do_run "${1:-}" ;;
    approve) do_approve "${1:-}" ;;
    deny) do_deny "${1:-}" ;;
    pending) do_pending ;;
    help|-h|--help) sed -n '2,37p' "$0" ;;
    *) refuse "unknown command '$cmd' (see: ioms-ops help, ioms-ops policy)" ;;
esac
rc=$?
audit "$([[ $rc -eq 0 ]] && echo ok || echo failed)" "$rc"
exit $rc
