# PRODUCTION CHECKLIST (Milestone 1 -- see README.md's "Security checklist
# before going live" for the full list): on any real server, APP_ENV must
# be "production", APP_DEBUG must be "false" (a "true" value here leaks
# full stack traces -- file paths, SQL, env vars -- to any visitor who
# triggers an error), and APP_URL must be the real https:// domain, not
# localhost. This file's own defaults below are LOCAL DEVELOPMENT values
# only -- copying this file as-is to a production .env is itself a
# blocker, not just a misconfiguration.
APP_NAME="IOMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# PRODUCTION (iomsuite.com): APP_URL is the ONE setting the whole application
# builds absolute URLs from -- password reset links, email links, the Midtrans
# finish callback, invoice links, asset URLs and the webhook URL you register
# in the Midtrans dashboard. Nothing else in the codebase names a domain, so
# migrating from ioms.web.id to iomsuite.com is this line plus the three
# session/Sanctum settings further down. Set it to the real https:// origin
# with no trailing slash:
#   APP_URL=https://iomsuite.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=safety_log
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
# Should match IOMS_NOREPLY_EMAIL below. In production that is
# noreply@iomsuite.com, sent from a host whose SPF/DKIM/DMARC cover
# iomsuite.com -- a From address the sending domain does not authorise is the
# usual reason transactional mail lands in spam.
MAIL_FROM_ADDRESS="noreply@iomsuite.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# IOMS specific -- PRODUCTION: SANCTUM_STATEFUL_DOMAINS must list the real
# domain (e.g. ioms.yourcompany.com), not localhost. If it doesn't match
# the domain the browser is actually on, Sanctum silently treats the
# request as cross-site: the session cookie either never gets set or gets
# rejected, and login appears to "succeed" (200 response) but the very
# next request is unauthenticated again -- a real, confirmed cause of
# "login doesn't work" that shows no error in Laravel's log at all. When
# unset, config/sanctum.php falls back to a localhost-only default, which
# is wrong for every real deployment.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000
# PRODUCTION: must be "true" once the site is served over HTTPS -- a
# session cookie sent without the Secure flag over HTTPS is rejected by
# some browsers and is a real security gap on every browser regardless.
SESSION_SECURE_COOKIE=false
# PRODUCTION: set to the registered domain so the session cookie is valid
# across it. Leave unset (null) unless you actually need a shared cookie --
# a wrong value here logs everybody out on every request.
# SESSION_DOMAIN=iomsuite.com

# Shared hosting (cPanel) terminates TLS at a proxy and forwards over plain
# HTTP, so without this Laravel sees the request as http:// and can generate
# insecure or wrong-host links -- including in password-reset emails. "*"
# trusts the hosting layer's own forwarding headers, which is the correct
# setting when the application is only reachable through that proxy. Set it
# to specific IPs if your host documents them.
TRUSTED_PROXIES=

# -----------------------------------------------------------------------------
# Payment provider (v2.51.0)
# -----------------------------------------------------------------------------
# Leave PAYMENT_GATEWAY unset to run with no payments configured. In that state
# IOMS issues real invoices and says plainly that online payment is not enabled;
# it never pretends a payment succeeded.
#
# Set PAYMENT_GATEWAY=midtrans AND both keys below to activate checkout. The
# adapter binds only when the gateway is named and the credentials are present,
# so a half-filled configuration keeps the safe no-payments behaviour instead of
# failing somewhere less obvious.
#
# You must ALSO register this URL as the Payment Notification URL in the
# Midtrans dashboard, or no payment can ever activate a subscription:
#   https://iomsuite.com/webhooks/payment/midtrans
# (or https://<your-domain>/webhooks/payment/midtrans on any other deployment)
PAYMENT_GATEWAY=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
PAYMENT_CURRENCY=IDR
PAYMENT_CHECKOUT_EXPIRY_HOURS=24

# Automatic recurring charging is NOT available by default -- Midtrans
# Subscription/Recurring requires supported channels and separate merchant-side
# activation. Leave false unless the merchant account has it activated; false
# means invoice-per-cycle renewal, which is fully implemented.
PAYMENT_RECURRING_ENABLED=false

# -----------------------------------------------------------------------------
# IOMS mailboxes (v2.52.0)
# -----------------------------------------------------------------------------
# Four addresses with four distinct jobs. Overridable so a deployment on a
# different domain needs no code change. MAIL_FROM_ADDRESS should normally match
# IOMS_NOREPLY_EMAIL.
IOMS_SUPPORT_EMAIL=support@iomsuite.com
IOMS_BILLING_EMAIL=billing@iomsuite.com
IOMS_NOREPLY_EMAIL=noreply@iomsuite.com
IOMS_HELLO_EMAIL=hello@iomsuite.com

# The brand address shown to humans (footer, About, documents). Distinct from
# APP_URL, which is what actually generates links.
IOMS_WEBSITE=iomsuite.com
# Product documentation. Leave blank until it is published -- a link that 404s
# costs more trust than an absent one, so IOMS renders it only when set.
IOMS_DOCUMENTATION_URL=

# -----------------------------------------------------------------------------
# Legal identity (v2.55.0)
# -----------------------------------------------------------------------------
# The registered operator named in the Terms of Service. EMPTY BY DEFAULT AND
# DELIBERATELY SO: IOMS omits any clause that would depend on a value it does
# not have rather than printing a guess, because a fabricated legal entity or
# governing-law clause is worse than an absent one.
#
# PRIVATE vs PUBLIC. The identity a payment provider verifies (personal name,
# residential address, NPWP, ID documents) is NOT website content. Set
# IOMS_LEGAL_ADDRESS only to an address you intend to publish -- never a home
# address. There is deliberately no key for a tax or registration number.
IOMS_LEGAL_ENTITY=
IOMS_LEGAL_ADDRESS=
IOMS_JURISDICTION=
IOMS_LEGAL_VENUE=
IOMS_LEGAL_EFFECTIVE_DATE=

# -----------------------------------------------------------------------------
# IOMS Sandbox (v2.53.0)
# -----------------------------------------------------------------------------
# A product DEMONSTRATION, not a free trial. Seed it with:
#   php artisan db:seed --class=DemoTenantSeeder
# With IOMS_SANDBOX_ENABLED=false, /sandbox 404s and the public CTAs are hidden,
# so a deployment that has not seeded the demo never advertises one.
IOMS_SANDBOX_ENABLED=true
IOMS_SANDBOX_TENANT=ioms-sandbox
IOMS_SANDBOX_USER=demo@iomsuite.com
